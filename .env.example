# ClipCC Configuration

# Model to auto-load at startup (see Available Models in README)
DEFAULT_MODEL_ID=siglip2-base-patch16-256

# Upload and processing limits
MAX_FILE_SIZE_MB=500
MAX_DURATION_SECONDS=300
MAX_FRAMES=300
DEFAULT_FPS=1.0
BATCH_SIZE=32

# Concurrency
MAX_CONCURRENT_REQUESTS=2

# Authentication (fail-closed: one of these must be set)
# API_KEY=your-secret-key-here
ALLOW_UNAUTHENTICATED=true
# Skip automatic model loading at startup (useful for CI or deferred-load deployments)
# SKIP_MODEL_AUTOLOAD=false

# Timeouts
FFMPEG_TIMEOUT_SECONDS=120
REQUEST_TIMEOUT_SECONDS=300

# Paths (Docker defaults shown — native users MUST override these)
# macOS/Linux native: TEMP_DIR=/tmp/clipcc  CLIP_CACHE_DIR=~/.cache/clipcc_models
# Windows native:     TEMP_DIR=C:\temp\clipcc  CLIP_CACHE_DIR=C:\temp\clipcc_models
TEMP_DIR=/tmp/clipcc
CLIP_CACHE_DIR=/app/models

# Local development: point to repo-local model cache (run scripts/download_models.py first)
# CLIP_CACHE_DIR=./models
# CLIPCC_OFFLINE=1

# Default labels for the classification UI (JSON array of strings)
# DEFAULT_LABELS=["texting while driving","sleeping while driving","eating while driving"]

# --- Gemma 4 E2B VLM + Hybrid mode (warm-on-demand, off the classify path) ---
# Powers /gemma and /hybrid. The slot loads only when warmed (POST /api/v1/gemma/warm),
# never at startup. GPU loads bf16 (~11.4GB VRAM); CPU loads fp32 (~22GB RAM, demo-only).
# Leave disabled on CPU-only / memory-constrained hosts.
GEMMA_ENABLED=false
# GEMMA_MODEL_ID=google/gemma-4-E2B-it

# Sampling / output limits (defaults shown — usually no need to change)
# GEMMA_MAX_FRAMES=8                 # frames sampled per Gemma request
# GEMMA_MAX_FRAMES_CAP=16            # hard cap on the per-request frame slider
# GEMMA_MAX_LABELS=50               # max labels accepted per request
# GEMMA_ANALYSIS_WINDOW_SECONDS=60
# GEMMA_MAX_NEW_TOKENS_QA=400
# GEMMA_MAX_NEW_TOKENS_VERDICT=160
# GEMMA_IMAGE_TOKEN_BUDGET=280
# GEMMA_EVIDENCE_TOP_K=3
# HYBRID_MAX_VERIFIED_LABELS=6      # top-k SigLIP2 labels passed to Gemma for verification
# HYBRID_THUMBNAIL_PX=160

# Memory gating (bytes reserved before a load is allowed; tune per device)
# GEMMA_RESERVE_GB=12.0        # bf16 footprint — used when CUDA or MPS is available
# GEMMA_RESERVE_GB_CPU=24.0    # fp32 footprint — used on x86 CPU-only hosts (~2x bf16)
# RESIDENCY_HEADROOM_GB=2.0
