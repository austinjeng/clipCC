# ClipCC Configuration

# Model to auto-load at startup (see Available Models in README)
DEFAULT_MODEL_ID=siglip2-base-patch16-256

# Upload and processing limits
MAX_FILE_SIZE_MB=500
MAX_DURATION_SECONDS=300
MAX_FRAMES=300
DEFAULT_FPS=1.0
BATCH_SIZE=32

# Concurrency
MAX_CONCURRENT_REQUESTS=2

# Authentication (fail-closed: one of these must be set)
# API_KEY=your-secret-key-here
ALLOW_UNAUTHENTICATED=true
# Skip automatic model loading at startup (useful for CI or deferred-load deployments)
# SKIP_MODEL_AUTOLOAD=false

# Timeouts
FFMPEG_TIMEOUT_SECONDS=120
REQUEST_TIMEOUT_SECONDS=300

# Paths (Docker defaults shown — native users MUST override these)
# macOS/Linux native: TEMP_DIR=/tmp/clipcc  CLIP_CACHE_DIR=~/.cache/clipcc_models
# Windows native:     TEMP_DIR=C:\temp\clipcc  CLIP_CACHE_DIR=C:\temp\clipcc_models
TEMP_DIR=/tmp/clipcc
CLIP_CACHE_DIR=/app/models
